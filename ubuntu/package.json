{
  "name": "@linux-toolchain/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "bun apps/linux-toolchain/src/main.ts",
    "dev:td": "bun --bun nx run-many -t serve -p term-dashboard term-dashboard-web --parallel=2",
    "link:td": "bun --bun nx build term-dashboard && cd dist/apps/term-dashboard && bun link",
    "unlink:td": "cd dist/apps/term-dashboard && bun unlink",
    "lint": "bun --bun nx run-many -t lint",
    "test": "bun --bun nx run-many -t test",
    "build": "bun --bun nx run-many -t build",
    "e2e": "bun --bun nx run-many -t e2e",
    "format:check": "bun --bun nx format:check --all",
    "format": "bun --bun nx format:write"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@inquirer/prompts": "^8.7.5",
    "@monaco-editor/react": "^4.7.0",
    "@nx/esbuild": "^24.0.5",
    "@nx/eslint": "^24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/node": "^24.0.5",
    "@nx/vitest": "^24.0.5",
    "@nx/workspace": "24.0.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "~5.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chalk": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
