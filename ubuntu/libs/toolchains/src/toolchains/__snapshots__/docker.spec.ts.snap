// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`docker > installs every add-on with verified asset names (amd64) 1`] = `
[
  {
    "as": "root",
    "label": "docker: engine",
    "script": "if dpkg -l docker.io 2>/dev/null | grep -q '^ii'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'docker.io is installed; installing docker-ce will replace it' >&2
fi
if ! apt-get install -y --no-install-recommends 'ca-certificates' 'curl'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'ca-certificates' 'curl'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
install -m 0755 -d /etc/apt/keyrings
curl -fsSL 'https://download.docker.com/linux/ubuntu/gpg' -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: noble
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
usermod -aG docker 'alice'
docker --version",
  },
  {
    "as": "root",
    "label": "docker: lazydocker",
    "script": "(
set -e
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp"/'lazydocker_0.25.2_Linux_x86_64.tar.gz' 'https://github.com/jesseduffield/lazydocker/releases/download/v0.25.2/lazydocker_0.25.2_Linux_x86_64.tar.gz'
curl -fsSL --retry 3 -o "$tmp/checksums" 'https://github.com/jesseduffield/lazydocker/releases/download/v0.25.2/checksums.txt'
expected=$(awk -v n='lazydocker_0.25.2_Linux_x86_64.tar.gz' 'NR==1 && NF==1 {h=$1} {f=$2; sub(/^\\*/, "", f)} f==n {print $1; found=1; exit} END {if (!found && h) print h}' "$tmp/checksums")
[ -n "$expected" ] || { echo 'no sha256 for lazydocker_0.25.2_Linux_x86_64.tar.gz in https://github.com/jesseduffield/lazydocker/releases/download/v0.25.2/checksums.txt' >&2; exit 1; }
printf '%s  %s\\n' "$expected" "$tmp"/'lazydocker_0.25.2_Linux_x86_64.tar.gz' | sha256sum -c --quiet -
mkdir "$tmp/x"
tar -xzf "$tmp"/'lazydocker_0.25.2_Linux_x86_64.tar.gz' -C "$tmp/x"
src="$tmp/x"/'lazydocker'
install -d '/usr/local/bin'
install -m 0755 "$src" '/usr/local/bin/lazydocker'
)",
  },
  {
    "as": "root",
    "label": "docker: dive",
    "script": "(
set -e
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp"/'dive_0.13.1_linux_amd64.tar.gz' 'https://github.com/wagoodman/dive/releases/download/v0.13.1/dive_0.13.1_linux_amd64.tar.gz'
curl -fsSL --retry 3 -o "$tmp/checksums" 'https://github.com/wagoodman/dive/releases/download/v0.13.1/dive_0.13.1_checksums.txt'
expected=$(awk -v n='dive_0.13.1_linux_amd64.tar.gz' 'NR==1 && NF==1 {h=$1} {f=$2; sub(/^\\*/, "", f)} f==n {print $1; found=1; exit} END {if (!found && h) print h}' "$tmp/checksums")
[ -n "$expected" ] || { echo 'no sha256 for dive_0.13.1_linux_amd64.tar.gz in https://github.com/wagoodman/dive/releases/download/v0.13.1/dive_0.13.1_checksums.txt' >&2; exit 1; }
printf '%s  %s\\n' "$expected" "$tmp"/'dive_0.13.1_linux_amd64.tar.gz' | sha256sum -c --quiet -
mkdir "$tmp/x"
tar -xzf "$tmp"/'dive_0.13.1_linux_amd64.tar.gz' -C "$tmp/x"
src="$tmp/x"/'dive'
install -d '/usr/local/bin'
install -m 0755 "$src" '/usr/local/bin/dive'
)",
  },
  {
    "as": "root",
    "label": "docker: hadolint",
    "script": "(
set -e
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp"/'hadolint-linux-x86_64' 'https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64'
curl -fsSL --retry 3 -o "$tmp/checksums" 'https://github.com/hadolint/hadolint/releases/download/v2.15.1/checksums.sha256'
expected=$(awk -v n='hadolint-linux-x86_64' 'NR==1 && NF==1 {h=$1} {f=$2; sub(/^\\*/, "", f)} f==n {print $1; found=1; exit} END {if (!found && h) print h}' "$tmp/checksums")
[ -n "$expected" ] || { echo 'no sha256 for hadolint-linux-x86_64 in https://github.com/hadolint/hadolint/releases/download/v2.15.1/checksums.sha256' >&2; exit 1; }
printf '%s  %s\\n' "$expected" "$tmp"/'hadolint-linux-x86_64' | sha256sum -c --quiet -
src="$tmp"/'hadolint-linux-x86_64'
install -d '/usr/local/bin'
install -m 0755 "$src" '/usr/local/bin/hadolint'
)",
  },
]
`;

