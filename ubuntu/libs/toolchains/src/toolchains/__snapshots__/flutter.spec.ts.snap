// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`flutter > all options on an existing checkout: switch channel and upgrade, web + fvm (android-sdk is its own component) 1`] = `
[
  {
    "as": "root",
    "label": "install Flutter build prerequisites",
    "script": "if ! apt-get install -y --no-install-recommends 'curl' 'git' 'unzip' 'xz-utils' 'zip' 'ca-certificates' 'libglu1-mesa' 'clang' 'cmake' 'ninja-build' 'pkg-config' 'libgtk-3-dev' 'liblzma-dev' 'libstdc++-12-dev' 'libsecret-1-dev'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'curl' 'git' 'unzip' 'xz-utils' 'zip' 'ca-certificates' 'libglu1-mesa' 'clang' 'cmake' 'ninja-build' 'pkg-config' 'libgtk-3-dev' 'liblzma-dev' 'libstdc++-12-dev' 'libsecret-1-dev'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi",
  },
  {
    "as": "user",
    "label": "upgrade Flutter (beta)",
    "script": "export PATH=/opt/flutter/bin:$PATH
flutter channel 'beta'
flutter upgrade",
  },
  {
    "as": "root",
    "label": "configure Flutter ownership and PATH",
    "script": "chown -R 'alice' /opt/flutter
install -d /etc/profile.d
printf '%s\\n' 'case ":$PATH:" in *:/opt/flutter/bin:*) ;; *) export PATH="$PATH:/opt/flutter/bin" ;; esac' > '/etc/profile.d/devtools-flutter.sh'
chmod 644 '/etc/profile.d/devtools-flutter.sh'
for f in /etc/bash.bashrc /etc/zsh/zshrc; do
  [ -f "$f" ] || continue
  grep -qF '# devtools-profile-hook' "$f" && continue
  printf '%s\\n' '# devtools-profile-hook' 'for _f in /etc/profile.d/devtools-*.sh; do [ -r "$_f" ] && . "$_f"; done; unset _f' >> "$f"
done",
  },
  {
    "as": "user",
    "label": "precache Flutter",
    "script": "export PATH=/opt/flutter/bin:$PATH
flutter precache
flutter --version",
  },
  {
    "as": "user",
    "label": "link Flutter to the Android SDK if present",
    "script": "if [ -x /opt/flutter/bin/flutter ] && [ -x /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager ]; then
  export PATH=/opt/flutter/bin:$PATH
  flutter config --android-sdk /opt/android-sdk
fi",
  },
  {
    "as": "user",
    "label": "enable Flutter web support",
    "script": "export PATH=/opt/flutter/bin:$PATH
flutter config --enable-web",
  },
  {
    "as": "user",
    "label": "install fvm",
    "script": "export PATH=/opt/flutter/bin:$PATH
dart pub global activate fvm
for f in "$HOME/.bashrc" "$HOME/.zshrc"; do
  [ -f "$f" ] || continue
  grep -qF '# >>> pub-cache >>>' "$f" && continue
  printf '\\n# >>> %s >>>\\n%s\\n# <<< %s <<<\\n' 'pub-cache' 'case ":$PATH:" in *:"$HOME/.pub-cache/bin":*) ;; *) export PATH="$PATH:$HOME/.pub-cache/bin" ;; esac' 'pub-cache' >> "$f"
done",
  },
]
`;

exports[`flutter > defaults: prerequisites, stable clone owned by the user, profile, precache, fvm (bash parity + fvm) 1`] = `
[
  {
    "as": "root",
    "label": "install Flutter build prerequisites",
    "script": "if ! apt-get install -y --no-install-recommends 'curl' 'git' 'unzip' 'xz-utils' 'zip' 'ca-certificates' 'libglu1-mesa' 'clang' 'cmake' 'ninja-build' 'pkg-config' 'libgtk-3-dev' 'liblzma-dev' 'libstdc++-12-dev' 'libsecret-1-dev'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'curl' 'git' 'unzip' 'xz-utils' 'zip' 'ca-certificates' 'libglu1-mesa' 'clang' 'cmake' 'ninja-build' 'pkg-config' 'libgtk-3-dev' 'liblzma-dev' 'libstdc++-12-dev' 'libsecret-1-dev'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi",
  },
  {
    "as": "root",
    "label": "create /opt/flutter",
    "script": "install -d -o 'alice' /opt/flutter",
  },
  {
    "as": "user",
    "label": "clone Flutter (stable)",
    "script": "git clone -b 'stable' https://github.com/flutter/flutter.git /opt/flutter",
  },
  {
    "as": "root",
    "label": "configure Flutter ownership and PATH",
    "script": "chown -R 'alice' /opt/flutter
install -d /etc/profile.d
printf '%s\\n' 'case ":$PATH:" in *:/opt/flutter/bin:*) ;; *) export PATH="$PATH:/opt/flutter/bin" ;; esac' > '/etc/profile.d/devtools-flutter.sh'
chmod 644 '/etc/profile.d/devtools-flutter.sh'
for f in /etc/bash.bashrc /etc/zsh/zshrc; do
  [ -f "$f" ] || continue
  grep -qF '# devtools-profile-hook' "$f" && continue
  printf '%s\\n' '# devtools-profile-hook' 'for _f in /etc/profile.d/devtools-*.sh; do [ -r "$_f" ] && . "$_f"; done; unset _f' >> "$f"
done",
  },
  {
    "as": "user",
    "label": "precache Flutter",
    "script": "export PATH=/opt/flutter/bin:$PATH
flutter precache
flutter --version",
  },
  {
    "as": "user",
    "label": "link Flutter to the Android SDK if present",
    "script": "if [ -x /opt/flutter/bin/flutter ] && [ -x /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager ]; then
  export PATH=/opt/flutter/bin:$PATH
  flutter config --android-sdk /opt/android-sdk
fi",
  },
  {
    "as": "user",
    "label": "install fvm",
    "script": "export PATH=/opt/flutter/bin:$PATH
dart pub global activate fvm
for f in "$HOME/.bashrc" "$HOME/.zshrc"; do
  [ -f "$f" ] || continue
  grep -qF '# >>> pub-cache >>>' "$f" && continue
  printf '\\n# >>> %s >>>\\n%s\\n# <<< %s <<<\\n' 'pub-cache' 'case ":$PATH:" in *:"$HOME/.pub-cache/bin":*) ;; *) export PATH="$PATH:$HOME/.pub-cache/bin" ;; esac' 'pub-cache' >> "$f"
done",
  },
]
`;
