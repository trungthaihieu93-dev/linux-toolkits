// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`android > all options: two platforms plus emulator, NDK and CMake as separate steps 1`] = `
[
  {
    "as": "root",
    "label": "install JDK for the Android SDK",
    "script": "if ! apt-get install -y --no-install-recommends 'openjdk-17-jdk-headless' 'unzip' 'curl' 'ca-certificates'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'openjdk-17-jdk-headless' 'unzip' 'curl' 'ca-certificates'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
if ! command -v java >/dev/null 2>&1; then
if ! apt-get install -y --no-install-recommends 'default-jdk-headless'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'default-jdk-headless'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
fi",
  },
  {
    "as": "root",
    "label": "install Android cmdline-tools (commandlinetools-linux-13114758_latest.zip)",
    "script": "(
set -e
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp/cmdline.zip" 'https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip'
unzip -q "$tmp/cmdline.zip" -d "$tmp"
rm -rf /opt/android-sdk/cmdline-tools/latest
install -d /opt/android-sdk/cmdline-tools
mv "$tmp/cmdline-tools" /opt/android-sdk/cmdline-tools/latest
)
chown -R 'alice' /opt/android-sdk",
  },
  {
    "as": "user",
    "label": "install Android SDK packages",
    "script": "export ANDROID_HOME=/opt/android-sdk
sdkm="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
list=$("$sdkm" --list 2>/dev/null)
yes | "$sdkm" --licenses >/dev/null || true
bt=$(printf '%s\\n' "$list" | grep -oE 'build-tools;[0-9]+\\.[0-9]+\\.[0-9]+ ' | sort -uV | tail -n1 | tr -d ' ')
[ -n "$bt" ] || { echo 'could not find build-tools in sdkmanager --list' >&2; exit 1; }
mapfile -t pl < <(printf '%s\\n' "$list" | grep -oE 'platforms;android-[0-9]+ ' | sort -uV | tail -n2 | tr -d ' ')
[ "\${#pl[@]}" -gt 0 ] || { echo 'could not find a platform in sdkmanager --list' >&2; exit 1; }
echo "Installing platform-tools $bt \${pl[*]}"
yes | "$sdkm" "platform-tools" "$bt" "\${pl[@]}"",
  },
  {
    "as": "root",
    "label": "write Android SDK profile",
    "script": "install -d /etc/profile.d
printf '%s\\n' 'export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
case ":$PATH:" in *:$ANDROID_HOME/platform-tools:*) ;; *) export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools" ;; esac' > '/etc/profile.d/devtools-android.sh'
chmod 644 '/etc/profile.d/devtools-android.sh'
for f in /etc/bash.bashrc /etc/zsh/zshrc; do
  [ -f "$f" ] || continue
  grep -qF '# devtools-profile-hook' "$f" && continue
  printf '%s\\n' '# devtools-profile-hook' 'for _f in /etc/profile.d/devtools-*.sh; do [ -r "$_f" ] && . "$_f"; done; unset _f' >> "$f"
done",
  },
  {
    "as": "user",
    "label": "link Flutter to the Android SDK if present",
    "script": "if [ -x /opt/flutter/bin/flutter ] && [ -x /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager ]; then
  export PATH=/opt/flutter/bin:$PATH
  flutter config --android-sdk /opt/android-sdk
fi",
  },
  {
    "as": "user",
    "label": "install Android emulator + system image",
    "script": "export ANDROID_HOME=/opt/android-sdk
sdkm="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
list=$("$sdkm" --list 2>/dev/null)
case "$(uname -m)" in aarch64|arm64) abi=arm64-v8a ;; *) abi=x86_64 ;; esac
img=$(printf '%s\\n' "$list" | grep -oE "system-images;android-[0-9]+;google_apis;$abi " | sort -uV | tail -n1 | tr -d ' ')
[ -n "$img" ] || { echo 'could not find a google_apis system image in sdkmanager --list' >&2; exit 1; }
echo "Installing emulator $img"
yes | "$sdkm" "emulator" "$img"",
  },
  {
    "as": "user",
    "label": "install Android NDK",
    "script": "export ANDROID_HOME=/opt/android-sdk
sdkm="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
list=$("$sdkm" --list 2>/dev/null)
ndk=$(printf '%s\\n' "$list" | grep -oE 'ndk;[0-9]+\\.[0-9]+\\.[0-9]+ ' | sort -uV | tail -n1 | tr -d ' ')
[ -n "$ndk" ] || { echo 'could not find an NDK in sdkmanager --list' >&2; exit 1; }
echo "Installing $ndk"
yes | "$sdkm" "$ndk"",
  },
  {
    "as": "user",
    "label": "install Android CMake",
    "script": "export ANDROID_HOME=/opt/android-sdk
sdkm="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
list=$("$sdkm" --list 2>/dev/null)
cm=$(printf '%s\\n' "$list" | grep -oE 'cmake;[0-9]+\\.[0-9]+\\.[0-9]+ ' | sort -uV | tail -n1 | tr -d ' ')
[ -n "$cm" ] || { echo 'could not find CMake in sdkmanager --list' >&2; exit 1; }
echo "Installing $cm"
yes | "$sdkm" "$cm"",
  },
]
`;

