// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cpp > installs every add-on when all are chosen 1`] = `
[
  {
    "as": "root",
    "label": "cpp: packages",
    "script": "if ! apt-get install -y --no-install-recommends 'build-essential' 'gcc' 'g++' 'gdb' 'clang' 'clangd' 'clang-format' 'clang-tidy' 'lld' 'lldb' 'cmake' 'ninja-build' 'meson' 'make' 'pkg-config' 'autoconf' 'automake' 'libtool' 'bison' 'flex' 'ccache' 'valgrind' 'binutils' 'gdb-multiarch'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'build-essential' 'gcc' 'g++' 'gdb' 'clang' 'clangd' 'clang-format' 'clang-tidy' 'lld' 'lldb' 'cmake' 'ninja-build' 'meson' 'make' 'pkg-config' 'autoconf' 'automake' 'libtool' 'bison' 'flex' 'ccache' 'valgrind' 'binutils' 'gdb-multiarch'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
gcc --version | head -n1
clang --version | head -n1",
  },
  {
    "as": "root",
    "label": "cpp: cppcheck",
    "script": "if ! apt-get install -y --no-install-recommends 'cppcheck'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'cppcheck'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi",
  },
  {
    "as": "user",
    "label": "cpp: conan",
    "script": "if command -v uv >/dev/null 2>&1; then
  uv tool install conan
elif command -v pipx >/dev/null 2>&1; then
  pipx install conan
else
  echo 'conan needs uv or pipx (install the python component first)' >&2
  exit 1
fi",
  },
  {
    "as": "root",
    "label": "cpp: vcpkg prerequisites",
    "script": "if ! apt-get install -y --no-install-recommends 'git' 'curl' 'zip' 'unzip' 'tar'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'git' 'curl' 'zip' 'unzip' 'tar'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi",
  },
  {
    "as": "user",
    "label": "cpp: vcpkg",
    "script": "if [ -d "$HOME/.vcpkg/.git" ]; then
  git -C "$HOME/.vcpkg" pull --ff-only
else
  git clone https://github.com/microsoft/vcpkg "$HOME/.vcpkg"
fi
"$HOME/.vcpkg/bootstrap-vcpkg.sh" -disableMetrics
for f in "$HOME/.bashrc" "$HOME/.zshrc"; do
  [ -f "$f" ] || continue
  grep -qF '# >>> vcpkg >>>' "$f" && continue
  printf '\\n# >>> %s >>>\\n%s\\n# <<< %s <<<\\n' 'vcpkg' 'export VCPKG_ROOT="$HOME/.vcpkg"
export PATH="$VCPKG_ROOT:$PATH"' 'vcpkg' >> "$f"
done",
  },
]
`;

