// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`java > all options: every JDK, chosen default, every add-on (jenv is left to its component) 1`] = `
[
  {
    "as": "root",
    "label": "install OpenJDK 17, 21, 25",
    "script": "if ! apt-get install -y --no-install-recommends 'openjdk-17-jdk' 'openjdk-21-jdk' 'openjdk-25-jdk'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'openjdk-17-jdk' 'openjdk-21-jdk' 'openjdk-25-jdk'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
found=0
for v in '17' '21' '25'; do
  if compgen -G "/usr/lib/jvm/java-$v-openjdk-*" >/dev/null; then
    found=1
  else
    printf '\\033[1;33m[warn]\\033[0m %s\\n' "JDK $v not installed (not available from this release's apt repos?)" >&2
  fi
done
[ "$found" = 1 ] || { echo 'no JDK could be installed' >&2; exit 1; }
ls -d /usr/lib/jvm/java-*-openjdk-* 2>/dev/null || true",
  },
  {
    "as": "root",
    "label": "set default JDK 25",
    "script": "d=$(compgen -G '/usr/lib/jvm/java-25-openjdk-*' | head -n1 || true)
[ -n "$d" ] && [ -x "$d/bin/java" ] || { echo 'JDK 25 is not installed; default left unchanged' >&2; exit 1; }
update-alternatives --set java "$d/bin/java"
if [ -x "$d/bin/javac" ]; then update-alternatives --set javac "$d/bin/javac"; fi
java -version",
  },
  {
    "as": "root",
    "label": "install Maven",
    "script": "if ! apt-get install -y --no-install-recommends 'maven'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'maven'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
mvn -version",
  },
  {
    "as": "root",
    "label": "install Gradle 9.3.1",
    "script": "if ! apt-get install -y --no-install-recommends 'curl' 'unzip' 'ca-certificates'; then
  printf '\\033[1;33m[warn]\\033[0m %s\\n' 'bulk install failed, retrying package by package' >&2
  for p in 'curl' 'unzip' 'ca-certificates'; do
    apt-get install -y --no-install-recommends "$p" || printf '\\033[1;33m[warn]\\033[0m %s\\n' "skipped: $p" >&2
  done
fi
(
set -e
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp/gradle.zip" 'https://services.gradle.org/distributions/gradle-9.3.1-bin.zip'
expected=$(curl -fsSL --retry 3 'https://services.gradle.org/distributions/gradle-9.3.1-bin.zip.sha256' | awk 'NR==1 {print $1}')
[ -n "$expected" ] || { echo 'no sha256 published for https://services.gradle.org/distributions/gradle-9.3.1-bin.zip' >&2; exit 1; }
printf '%s  %s\\n' "$expected" "$tmp/gradle.zip" | sha256sum -c --quiet -
install -d '/opt/gradle'
rm -rf '/opt/gradle/gradle-9.3.1'
unzip -q "$tmp/gradle.zip" -d '/opt/gradle'
[ -x '/opt/gradle/gradle-9.3.1/bin/gradle' ] || { echo 'unexpected archive layout: /opt/gradle/gradle-9.3.1/bin/gradle missing' >&2; exit 1; }
ln -sfn '/opt/gradle/gradle-9.3.1' '/opt/gradle/current'
)
install -d /etc/profile.d
printf '%s\\n' 'case ":$PATH:" in *:/opt/gradle/current/bin:*) ;; *) export PATH="$PATH:/opt/gradle/current/bin" ;; esac' > '/etc/profile.d/devtools-gradle.sh'
chmod 644 '/etc/profile.d/devtools-gradle.sh'
for f in /etc/bash.bashrc /etc/zsh/zshrc; do
  [ -f "$f" ] || continue
  grep -qF '# devtools-profile-hook' "$f" && continue
  printf '%s\\n' '# devtools-profile-hook' 'for _f in /etc/profile.d/devtools-*.sh; do [ -r "$_f" ] && . "$_f"; done; unset _f' >> "$f"
done
/opt/gradle/current/bin/gradle --version",
  },
]
`;

exports[`java > defaults: JDK 21 as system default, Maven and the latest Gradle 1`] = `
[
  {
    "as": "root",
    "label": "install OpenJDK 21",
    "script": "if ! apt-get install -y --no-install-recommends 'openjdk-21-jdk'; then
