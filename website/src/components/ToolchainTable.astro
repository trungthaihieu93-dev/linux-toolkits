---
/**
 * Reference index of every toolchain, read from src/data/toolchains.json
 * (written by scripts/gen-toolchains.ts from the CLI catalog).
 */
import data from '../data/toolchains.json';

const { toolchains } = data;
const pageUrl = (id: string) => `/ubuntu/toolchains/${id}/`;
---

<div class="toolchain-table not-content" role="region" aria-labelledby="toolchain-table-caption" tabindex="0">
	<table>
		<caption id="toolchain-table-caption">
			All {toolchains.length} toolchains, in install order
		</caption>
		<thead>
			<tr>
				<th scope="col">Id</th>
				<th scope="col">Toolchain</th>
				<th scope="col">Installs</th>
				<th scope="col">Requires</th>
			</tr>
		</thead>
		<tbody>
			{
				toolchains.map((t) => (
					<tr>
						<th scope="row">
							<code>{t.id}</code>
						</th>
						<td>
							<a href={pageUrl(t.id)}>{t.label}</a>
						</td>
						<td>{t.description}</td>
						<td>
							{t.requires.length === 0 ? (
								<span class="none">none</span>
							) : (
								t.requires.map((req, i) => (
									<>
										{i > 0 && ', '}
										<a href={pageUrl(req)}>
											<code>{req}</code>
										</a>
									</>
								))
							)}
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	/* Tables scroll inside this region, never the page (375px screens). */
	.toolchain-table {
		margin-block: 1.5rem;
		max-width: 100%;
		overflow-x: auto;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.5rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	caption {
		padding: 0.75rem 1rem;
		text-align: start;
		color: var(--sl-color-gray-3);
	}
	th,
	td {
		padding: 0.5rem 1rem;
		text-align: start;
		vertical-align: top;
		border-top: 1px solid var(--sl-color-hairline-light);
	}
	thead th {
		color: var(--sl-color-white);
		font-weight: 600;
		background-color: var(--sl-color-gray-6);
	}
	tbody th {
		font-weight: 400;
		white-space: nowrap;
	}
	td:nth-child(2) {
		min-width: 9rem;
	}
	td:nth-child(3) {
		min-width: 14rem;
	}
	code {
		font-family: var(--__sl-font-mono);
		font-size: 0.875em;
		color: var(--sl-color-gray-1);
		background-color: var(--sl-color-bg-inline-code);
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		white-space: nowrap;
	}
	a {
		color: var(--sl-color-text-accent);
	}
	a:hover {
		color: var(--sl-color-white);
	}
	.none {
		color: var(--sl-color-gray-3);
	}
</style>
